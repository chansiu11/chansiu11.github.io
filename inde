        });

        const handleDisconnect = () => {
            if (c.playerId) {
                delete remotePlayers[c.playerId];
            }
            delete connections[c.peer];
            updateHUD();
        };

        c.on('close', handleDisconnect);
        c.on('error', handleDisconnect);
    });
