<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>2D 배틀필드 로얄 - 멀티플레이어</title>
    <style>
        * { box-sizing: border-box; touch-action: none; user-select: none; }
        html, body {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background-color: #050505; color: white; font-family: sans-serif; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
        }

        #gameFrame {
            position: relative;
            width: 100vw;
            height: 56.25vw;
            max-height: 100vh;
            max-width: 177.78vh;
            background-color: #111;
            overflow: hidden;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.9);
            border: 1px solid #333;
        }

        #ui, #waitingRoom, #settingsModal, #weaponSelectModal {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            background: rgba(20, 20, 20, 0.95); padding: 25px; border-radius: 12px;
            display: flex; flex-direction: column; gap: 12px; align-items: center;
            box-shadow: 0 0 20px rgba(0,0,0,0.8); width: 380px; z-index: 50;
        }
        #waitingRoom {
            background: rgba(15, 15, 15, 0.95); padding: 30px;
            display: none; box-shadow: 0 0 25px rgba(0,255,200,0.3); width: 420px; text-align: center;
        }
        #settingsModal { display: none; z-index: 100; border: 2px solid #00ffcc; width: 380px; }
        #weaponSelectModal { display: none; z-index: 90; border: 2px solid #ffcc00; width: 400px; text-align: center; }

        input[type="text"], select, input[type="number"], input[type="range"] {
            padding: 10px; font-size: 15px; border-radius: 6px; border: 1px solid #444;
            text-align: center; width: 100%; background: #222; color: white;
        }
        .form-group { width: 100%; text-align: left; font-size: 14px; color: #ccc; }
        .form-group label { display: block; margin-bottom: 5px; }
        button {
            padding: 12px; font-size: 15px; background-color: #00ffcc; border: none;
            border-radius: 6px; cursor: pointer; font-weight: bold; color: #000; width: 100%;
        }
        button:hover { background-color: #00cc88; }
        .btn-secondary { background-color: #555; color: white; }
        .btn-secondary:hover { background-color: #777; }

        #statusHUD {
            position: absolute; top: 20px; left: 20px; font-size: 14px; font-weight: bold;
            text-shadow: 2px 2px 4px #000; z-index: 20; display: none; background: rgba(0,0,0,0.6); padding: 12px; border-radius: 8px;
            pointer-events: none;
        }
        #spawnSelectHUD {
            position: absolute; top: 20px; left: 50%; transform: translateX(-50%);
            font-size: 20px; font-weight: bold; color: #00ffcc; text-shadow: 2px 2px 4px #000;
            z-index: 35; display: none; background: rgba(0,0,0,0.8); padding: 12px 24px; border-radius: 8px;
            pointer-events: none; text-align: center; border: 2px solid #00ffcc;
        }
        #spectateHUD {
            position: absolute; top: 20px; left: 50%; transform: translateX(-50%);
            font-size: 18px; font-weight: bold; color: #ffcc00; text-shadow: 2px 2px 4px #000;
            z-index: 25; display: none; background: rgba(0,0,0,0.7); padding: 10px 20px; border-radius: 8px;
            pointer-events: none; text-align: center; border: 1px solid #ffcc00;
        }
        #respawnHUD {
            position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%);
            font-size: 28px; font-weight: bold; color: #ff4444; text-shadow: 2px 2px 6px #000;
            z-index: 25; display: none; background: rgba(0,0,0,0.8); padding: 20px 40px; border-radius: 12px;
            pointer-events: none; text-align: center; border: 2px solid #ff4444;
        }
        #killNotification {
            position: absolute; top: 30%; left: 50%; transform: translate(-50%, -50%) scale(1);
            font-size: 36px; font-weight: bold; color: #ffcc00; text-shadow: 2px 2px 8px #000, 0 0 20px rgba(255,204,0,0.8);
            z-index: 45; display: none; pointer-events: none; text-align: center;
            transition: transform 0.15s ease-out;
        }
        #inventory {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 500px; height: 480px; background: rgba(20, 20, 20, 0.95);
            border: 2px solid #00ffcc; border-radius: 10px; z-index: 60; display: none;
            padding: 20px; flex-direction: column; gap: 10px; overflow-y: auto;
        }
        .inv-section { border: 1px solid #444; padding: 8px; border-radius: 6px; background: #1a1a1a; }
        .inv-grid { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
        .inv-item {
            padding: 6px 10px; background: #333; border: 1px solid #666; border-radius: 4px;
            cursor: pointer; font-size: 13px;
        }
        .inv-item:hover { background: #00ffcc; color: #000; }
        #minimapCanvas {
            position: absolute; bottom: 20px; right: 20px;
            width: 200px; height: 200px;
            background: rgba(15, 15, 15, 0.9);
            border: 2px solid #00ffcc; border-radius: 50%;
            z-index: 20; display: none; box-shadow: 0 0 15px rgba(0,255,200,0.2);
            pointer-events: none;
        }
        #fullMapOverlay {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 80vh; height: 80vh; background: rgba(10, 10, 10, 0.92);
            border: 3px solid #00ffcc; border-radius: 12px; z-index: 70; display: none;
            box-shadow: 0 0 30px rgba(0,0,0,0.9); flex-direction: column; align-items: center; justify-content: center;
        }
        #victoryOverlay {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.9); border: 4px solid #ffcc00; padding: 30px;
            border-radius: 20px; text-align: center; display: none; z-index: 100;
            box-shadow: 0 0 50px rgba(255, 204, 0, 0.5); min-width: 320px;
        }
        #rankList {
            margin: 15px 0; text-align: left; font-size: 16px; line-height: 1.6;
            max-height: 200px; overflow-y: auto; background: rgba(255,255,255,0.05); padding: 10px; border-radius: 8px;
        }
        #damageOverlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 15; opacity: 0;
            box-shadow: inset 0 0 100px 50px rgba(255, 0, 0, 0.8);
            transition: opacity 0.1s ease-out;
        }
        canvas#gameCanvas { position: absolute; top:0; left:0; width: 100%; height: 100%; display: none; background-color: #000; z-index: 1; }

        #mobileControls {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            z-index: 30; pointer-events: none; display: none;
        }
        .touch-zone { position: absolute; pointer-events: auto; }
        
        #moveTouchArea {
            position: absolute; top: 0; left: 0; width: 50%; height: 100%;
            pointer-events: auto;
        }
        #aimTouchArea {
            position: absolute; top: 0; right: 0; width: 50%; height: 100%;
            pointer-events: auto;
        }

        #joystickContainer, #aimPadContainer {
            position: absolute; width: 140px; height: 140px;
            background: rgba(255, 255, 255, 0.15); border: 2px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%; display: none; transform: translate(-50%, -50%);
            pointer-events: none;
        }
        #joystickKnob {
            position: absolute; top: 45px; left: 45px; width: 50px; height: 50px;
            background: rgba(0, 255, 204, 0.7); border-radius: 50%;
        }
        #aimPadKnob {
            position: absolute; top: 45px; left: 45px; width: 50px; height: 50px;
            background: rgba(255, 68, 68, 0.7); border-radius: 50%;
        }

        .mobile-btn {
            position: absolute; width: 65px; height: 65px; border-radius: 50%;
            background: rgba(0,0,0,0.6); border: 2px solid #00ffcc; color: white;
            font-weight: bold; font-size: 13px; display: flex; align-items: center; justify-content: center;
            z-index: 40; pointer-events: auto;
        }
        #btnReload { bottom: 35px; right: 190px; }
        #btnPickup { bottom: 185px; right: 40px; }
        #btnBag { bottom: 185px; right: 120px; }
        #btnMap { top: 20px; right: 20px; width: 55px; height: 55px; border-color: #ffcc00; color: #ffcc00; }
        #btnSettings { top: 20px; right: 85px; width: 55px; height: 55px; border-color: #aaaaaa; color: #ffffff; }

        .edit-active .touch-zone {
            outline: 2px dashed #00ffcc !important;
            cursor: move;
        }
        
        .info-value { color: #00ffcc; font-weight: bold; float: right; }
    </style>
    <script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
</head>
<body>

<div id="gameFrame">
    <div id="damageOverlay"></div>
    <div id="killNotification"></div>

    <div id="ui">
        <h2>2D 배틀필드 로얄</h2>
        <input type="text" id="nicknameInput" placeholder="닉네임 입력" maxlength="10">

        <div class="form-group">
            <label for="platformSelect">플레이 조작 기기:</label>
            <select id="platformSelect">
                <option value="pc">PC (키보드 & 마우스)</option>
                <option value="mobile">Mobile (터치 패드)</option>
            </select>
        </div>

        <div class="form-group">
            <label for="gameModeSelect">게임 모드 선택:</label>
            <select id="gameModeSelect">
                <option value="br">배틀로얄 모드 (자기장 ON)</option>
                <option value="normal">기본 모드 (데스매치 / 자기장 OFF)</option>
            </select>
        </div>

        <button onclick="createRoom()">방 생성 (방장)</button>
        <div id="roomCodeDisplay" style="color:#00ffcc; font-weight:bold;"></div>

        <hr style="width:100%; border-color:#444; margin: 2px 0;">
        
        <input type="text" id="joinIdInput" placeholder="방 코드 입력" maxlength="5">
        <button onclick="joinRoom()" style="background-color: #ffcc00;">방 참가하기</button>
        <button onclick="openSettings()" class="btn-secondary" style="margin-top: 4px;">⚙️ 설정</button>
    </div>

    <div id="settingsModal">
        <h2 style="margin-top:0;">🎮 설정</h2>
        <div class="form-group">
            <label for="controlScaleInput">모바일 UI 크기 스케일:</label>
            <input type="range" id="controlScaleInput" min="0.6" max="1.4" step="0.1" value="1" oninput="updateControlScale(this.value)">
        </div>
        <button onclick="toggleEditMobileKeys()" id="editKeysBtn" style="background-color: #ffcc00; margin-bottom: 8px;">🖐️ 모바일 키 위치 drag 배치 수정</button>
        <button onclick="closeSettings()" class="btn-secondary">닫기</button>
    </div>

    <div id="waitingRoom">
        <h2 id="waitingTitle">대기실 (방장 설정)</h2>
        <p>방 코드: <span id="displayRoomCode" style="color:#00ffcc; font-size:20px; font-weight:bold;">-</span></p>
        
        <div id="hostSettingsControls" style="width:100%;">
            <div class="form-group">
                <label for="aiToggle">AI 봇 포함 여부:</label>
                <select id="aiToggle" onchange="onHostSettingsChange()">
                    <option value="true">AI 봇 포함</option>
                    <option value="false">AI 봇 없음 (유저 전용)</option>
                </select>
            </div>

            <div class="form-group" id="aiDifficultyGroup">
                <label for="aiDifficultySelect">AI 난이도 설정:</label>
                <select id="aiDifficultySelect" onchange="onHostSettingsChange()">
                    <option value="very_easy" selected>매우 쉬움 (최하 난이도)</option>
                    <option value="easy">쉬움</option>
                    <option value="hard">어려움</option>
                </select>
            </div>

            <div class="form-group" id="aiCountGroup">
                <label for="aiCountInput">AI 봇 수 (최대 <span id="maxAiText">100</span>):</label>
                <input type="number" id="aiCountInput" value="19" min="0" max="100" onchange="onHostSettingsChange()" oninput="onHostSettingsChange()">
            </div>
        </div>

        <div id="guestSettingsDisplay" style="display:none; width:100%; text-align:left; background:rgba(0,0,0,0.4); padding:15px; border-radius:8px; margin: 10px 0;">
            <div style="margin-bottom:8px;">게임 모드: <span id="guestModeVal" class="info-value">배틀로얄</span></div>
            <div style="margin-bottom:8px;">AI 봇 여부: <span id="guestAiVal" class="info-value">포함</span></div>
            <div style="margin-bottom:8px;">AI 난이도: <span id="guestDiffVal" class="info-value">매우 쉬움</span></div>
            <div>AI 봇 수: <span id="guestCountVal" class="info-value">19명</span></div>
        </div>

        <button id="startButton" onclick="hostStartGame()" style="background-color: #00ffcc; margin-top: 10px;">게임 시작</button>
        <p id="guestWaitText" style="color:#00ffcc; display:none; margin-top:15px;">방장이 게임을 시작하기를 기다리는 중...</p>
    </div>

    <div id="weaponSelectModal">
        <h2 style="color:#ffcc00; margin-top:0;">🔫 총기 선택 (10초)</h2>
        <p>사용할 주 무기를 선택하세요:</p>
        <div style="display:flex; flex-direction:column; gap:10px; width:100%;">
            <button onclick="selectDeathmatchWeapon('ar')">돌격소총 (AR)</button>
            <button onclick="selectDeathmatchWeapon('shotgun')">샷건 (Shotgun)</button>
            <button onclick="selectDeathmatchWeapon('sniper')">스나이퍼 (Sniper)</button>
        </div>
        <p style="margin-top:15px; font-weight:bold; color:#00ffcc;">남은 시간: <span id="weaponSelectTimer">10</span>초</p>
    </div>

    <div id="victoryOverlay">
        <h1 id="victoryTitle" style="font-size: 36px; color: #ffcc00; margin: 0;">🏆 승리! 🏆</h1>
        <div id="rankList"></div>
        <p style="font-size: 16px; color: #fff; margin-top: 15px;">5초 후 메인 메뉴로 이동합니다...</p>
    </div>

    <div id="spawnSelectHUD">
        📍 맵을 클릭하여 스폰 위치를 선택하세요! (<span id="spawnTimer">10</span>초)
    </div>

    <div id="statusHUD">
        [모드]: <span id="hudGameMode" style="color:#00ffcc;">배틀로얄</span> | 
        [생존 인원]: <span id="hudAliveCount" style="color:#ff4444; font-size: 16px;">20</span> 명 <br>
        [킬]: <span id="hudKills" style="color:#00ffcc;">0</span> | [데스]: <span id="hudDeaths" style="color:#ff4444;">0</span> <br>
        <span id="hudZoneContainer">[자기장 단계]: <span id="hudZoneStage" style="color:#00ffcc;">1단계</span> | [축소까지]: <span id="hudZoneTimer" style="color:#ffcc00;">60</span> 초<br></span>
        [무기]: <span id="hudWeapon" style="color:#00ffcc;">맨손</span> | [탄약]: <span id="hudAmmo" style="color:#ffcc00;">- / -</span> <br>
        [머리 갑바]: <span id="hudHelmet" style="color:#00ffcc;">없음</span> | [몸 갑바]: <span id="hudArmor" style="color:#00ffcc;">없음</span> <br>
        [장착 스코프]: <span id="hudScope" style="color:#ffcc00;">없음</span> <br>
        <span id="hudControlsHint">[조작법]: Shift(달리기) / Ctrl(은신) / E(줍기) / R(장전) / Tab(가방)</span>
    </div>

    <div id="spectateHUD">
        👁️ [관전 모드]<br>관전 대상: <span id="spectateTargetName" style="color:#00ffcc;">-</span>
    </div>

    <div id="respawnHUD">
        ☠️ 사망하셨습니다!<br>
        <span id="respawnTimer" style="color:#00ffcc; font-size:36px;">5</span> 초 후 부활합니다...
    </div>

    <div id="mobileControls">
        <div id="moveTouchArea"></div>
        <div id="aimTouchArea"></div>

        <div id="joystickContainer">
            <div id="joystickKnob"></div>
        </div>
        <div id="aimPadContainer">
            <div id="aimPadKnob"></div>
        </div>
        <div id="btnReload" class="mobile-btn touch-zone">장전</div>
        <div id="btnPickup" class="mobile-btn touch-zone">줍기</div>
        <div id="btnBag" class="mobile-btn touch-zone">가방</div>
        <div id="btnMap" class="mobile-btn touch-zone">지도</div>
        <div id="btnSettings" class="mobile-btn touch-zone" onclick="openSettings()">⚙️</div>
    </div>

    <div id="inventory">
        <h3 style="margin:0; text-align:center; color:#00ffcc;">가방 (인벤토리)</h3>
        <div class="inv-section">
            <strong>현재 무기:</strong>
            <div id="equippedWeaponArea" style="margin-top:5px; color:#aaa;">맨손</div>
        </div>
        <div class="inv-section">
            <strong>현재 장착 방어구:</strong>
            <div id="equippedArmorArea" style="margin-top:5px; color:#aaa;">머리: 없음 | 몸: 없음</div>
        </div>
        <div class="inv-section">
            <strong>보유 중인 방어구:</strong>
            <div id="armorList" class="inv-grid"></div>
        </div>
        <div class="inv-section">
            <strong>현재 장착 스코프:</strong>
            <div id="equippedScopeArea" style="margin-top:5px; color:#aaa;">없음</div>
        </div>
        <div class="inv-section">
            <strong>보유 중인 스코프:</strong>
            <div id="scopeList" class="inv-grid"></div>
        </div>
        <button onclick="toggleInventory()" style="margin-top:auto;">닫기 (Tab)</button>
    </div>

    <div id="fullMapOverlay" onclick="handleMapClick(event)">
        <h3 style="margin: 10px 0 5px 0; color:#00ffcc;">전체 맵 (<span id="mapNoticeText">터치하여 닫기</span>)</h3>
        <canvas id="fullMapCanvas" width="500" height="500"></canvas>
    </div>

    <canvas id="gameCanvas"></canvas>
    <canvas id="minimapCanvas" width="200" height="200"></canvas>
</div>

<script>
let WORLD_SIZE = 12000; // 배틀로얄 맵 확장을 위해 기존 8000에서 12000으로 증대

const SCOPES = {
    '1x': { name: "1배율 (레드닷)", viewOffset: 300 },
    '2x': { name: "2배율", viewOffset: 550 },
    '3x': { name: "3배율", viewOffset: 850 },
    '4x': { name: "4배율", viewOffset: 1200 },
    '8x': { name: "8배율", viewOffset: 1800 }
};

const ARMORS = {
    'helmet_1': { name: "1레벨 머리갑바", type: "helmet", reduction: 0.15 },
    'helmet_2': { name: "2레벨 머리갑바", type: "helmet", reduction: 0.30 },
    'helmet_3': { name: "3레벨 머리갑바", type: "helmet", reduction: 0.50 },
    'body_1': { name: "1레벨 몸갑바", type: "body", reduction: 0.15 },
    'body_2': { name: "2레벨 몸갑바", type: "body", reduction: 0.30 },
    'body_3': { name: "3레벨 몸갑바", type: "body", reduction: 0.50 }
};

const WEAPONS = {
    ar: { name: "돌격소총", cooldown: 110, bulletSpeed: 90, damage: 25, pellets: 1, spread: 0.03, maxClip: 30 },
    sniper: { name: "스나이퍼", cooldown: 900, bulletSpeed: 160, damage: 100, pellets: 1, spread: 0.005, maxClip: 5 },
    shotgun: { name: "샷건", cooldown: 800, bulletSpeed: 75, damage: 18, pellets: 8, spread: 0.18, maxClip: 8 }
};

const AI_DIFFICULTY = {
    very_easy: { delay: 3500, spread: 0.5, speedMult: 0.4 },
    easy: { delay: 900, spread: 0.15, speedMult: 0.8 },
    hard: { delay: 300, spread: 0.08, speedMult: 1.0 }
};

let peer = null;
let connections = {}; 
let hostConn = null;  
let isHost = false;
let selectedMode = 'br';
let isMobile = false;
let aiDifficulty = 'very_easy';

let gameStarted = false;
let gameEnded = false;
let initialPlayerCount = 1;

let isSpectating = false;
let spectateTarget = null;
let isRespawning = false;
let respawnTimerVal = 5;
let respawnInterval = null;

// 스폰 선택 및 자기장 단계 관리
let isSpawnSelecting = false;
let hasSelectedSpawn = false;
let spawnTimerVal = 10;
let spawnTimerInterval = null;

let zoneStage = 1;
let maxZoneStages = 5;
let zoneTimer = 60;
let isZoneShrinking = false;
let zoneTimerInterval = null;
let targetZone = { x: WORLD_SIZE / 2, y: WORLD_SIZE / 2, radius: WORLD_SIZE * 0.7 };
const zone = {
    x: WORLD_SIZE / 2,
    y: WORLD_SIZE / 2,
    radius: WORLD_SIZE * 0.7,
    shrinkRate: 3.0
};

// 데스매치 총기 선택 관리
let weaponSelectTimerVal = 10;
let weaponSelectInterval = null;

// 연속 킬 관련 변수
let killStreakCount = 0;
let killStreakTimer = null;

const gameFrame = document.getElementById('gameFrame');
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const minimapCanvas = document.getElementById('minimapCanvas');
const mCtx = minimapCanvas.getContext('2d');
const fullMapCanvas = document.getElementById('fullMapCanvas');
const fCtx = fullMapCanvas.getContext('2d');

function resizeCanvas() {
    canvas.width = gameFrame.clientWidth;
    canvas.height = gameFrame.clientHeight;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

let obstacles = [];
let droppedItems = [];

const myPlayer = {
    id: Math.random().toString(36).substring(2, 9),
    x: 1000,
    y: 1000,
    angle: 0, speed: 3.0, hp: 200, maxHp: 200,
    kills: 0, deaths: 0, isDead: false,
    name: '플레이어', weapon: null,
