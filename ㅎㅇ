function adminLevel(n){player.level=Math.floor(clamp(Number(n)||1,1,MAX_LEVEL));recalculateEquipment(true);player.xp=0;}
function adminGive(kind,n,drop){
 n=Math.floor(clamp(Number(n)||1,1,99999));
 const dropKinds={gold:'gold',herb:'herb',ore:'ore',potion:'potion'};
 if(drop){if(dropKinds[kind]){dropLoot(player.x+30,player.y+25,dropKinds[kind],n);return true;}toast('이 아이템은 바닥에 놓을 수 없어 가방으로 바로 지급했습니다.');}
 if(kind.startsWith('rune_')){const id=kind.slice(5);if(RUNES.some(r=>r.id===id)&&!player.runes.includes(id))player.runes.push(id);return true;}
 if(kind.startsWith('weapon')){const index=+kind.slice(6);if(Number.isInteger(index)&&WEAPONS[index]&&!player.ownedWeapons.includes(index))player.ownedWeapons.push(index);return true;}
 if(kind.startsWith('head_')){grantEquipment('head',kind.slice(5),false);return true;}
 if(kind.startsWith('chest_')){grantEquipment('chest',kind.slice(6),false);return true;}
 if(kind.startsWith('shield_')){grantEquipment('shield',kind.slice(7),false);return true;}
 if(/^blueprint[1-4]$/.test(kind)){if(!player.blueprintFragments.includes(kind))player.blueprintFragments.push(kind);return true;}
 if(kind==='frostCore'){player.frostCore=Math.floor(clamp(player.frostCore+n,0,99));return true;}
 if(kind==='abyssCore'){player.abyssCore=Math.floor(clamp(player.abyssCore+n,0,99));return true;}
 if(kind==='potion'){player.potions=Math.min(8,player.potions+n);return true;}
 const key={gold:'gold',herb:'herbs',ore:'ore'}[kind];if(key){player[key]+=n;return true;}return false;
}
$('panel').addEventListener('change',e=>{const flag=e.target.dataset.adminFlag;if(flag&&flag in admin)admin[flag]=e.target.checked;});
$('panel').addEventListener('click',e=>{const b=e.target.closest('[data-admin]');if(!b)return;const action=b.dataset.admin;
 if(action==='heal'){player.hp=player.maxHp;player.stam=player.maxStam;player.shield=player.maxShield;player.shieldBroken=0;}
 if(action==='cooldown'){player.skillCds.fill(0);player.attackCd=player.dodgeCd=player.parryCd=player.potionCd=player.exhaust=player.cast=0;}
 if(action==='level')adminLevel($('adminLevel').value);
 if(action==='levelDelta')adminLevel(player.level+Number(b.dataset.value||0));
 if(action==='levelMax')adminLevel(MAX_LEVEL);
 if(action==='allItems'){player.ownedWeapons=WEAPONS.map((_,i)=>i);player.ownedHead=HEAD_GEAR.map(g=>g.id);player.ownedChest=CHEST_GEAR.map(g=>g.id);player.ownedShields=SHIELD_GEAR.map(g=>g.id);player.upgrades=WEAPONS.map(()=>3);player.runes=RUNES.map(r=>r.id);recalculateEquipment(false);}
 if(action==='hiddenItems'){player.blueprintFragments=['blueprint1','blueprint2','blueprint3','blueprint4'];player.statueHits=3;player.statueBroken=true;player.frostCore=Math.max(player.frostCore,5);player.abyssCore=Math.max(player.abyssCore,5);}
 if(action==='materials'){player.gold+=50000;player.ore+=500;player.herbs+=500;player.potions=8;player.frostCore=Math.min(99,player.frostCore+10);player.abyssCore=Math.min(99,player.abyssCore+10);}
 if(action==='map'){player.camps=camps.map(c=>c.id);player.discovered=Array.from({length:1500},(_,i)=>i);seen.clear();player.discovered.forEach(n=>seen.add(n));}
 if(action==='progress'){player.seals=[0,1,2,3,4,5];player.won=true;player.storyStage=MAIN_QUESTS.length;player.rifts=RIFTS.map(r=>r.id);player.notes=['lore0','lore1','lore2','lore3'];player.acceptedSideQuests=SIDE_QUESTS.map(q=>q.id);player.claimedSideQuests=SIDE_QUESTS.map(q=>q.id);for(const q of SIDE_QUESTS)player.stats[q.stat]=Math.max(player.stats[q.stat]||0,q.target);for(const e of enemies)if(e.kind==='boss'){e.dead=true;e.hp=0;}player.stats.talked=1;player.stats.storyAltar=1;player.stats.bosses=3;player.stats.final=1;}
 if(action==='give'||action==='drop')adminGive($('adminItem').value,$('adminAmount').value,action==='drop');
 if(action==='spawn'){const type=$('adminMonster').value,e=addEnemy(type,player.x+Math.cos(player.facing)*180,player.y+Math.sin(player.facing)*180,'admin'+Date.now());e.alert=true;e.state='chase';}
 if(action==='travel'){cleanupRift();const [kind,id]=$('adminPlace').value.split(':'),target=kind==='camp'?camps.find(c=>c.id===id):arenas[+id];const p=freeBodySpot(target.x,target.y+100,player.r);player.x=p.x;player.y=p.y;camera.x=p.x;camera.y=p.y;player.invuln=3;projectiles=[];effects=[];bodyGridValid=false;}
 if(action==='rift'){const id=$('adminRift').value;cleanupRift();const r=RIFTS.find(r=>r.id===id),p=freeBodySpot(r.x,r.y+70,player.r);player.x=p.x;player.y=p.y;closeModal();startRift(id);return;}
 if(action==='clear')for(const e of enemies)if(!e.dead&&e.type!=='dummy'&&distance(e,player)<600)defeatEnemy(e);
 if(action==='resetEnemies')resetWorldState(true);
 if(action==='day')worldTime=Math.floor(worldTime/240)*240;
 if(action==='night')worldTime=Math.floor(worldTime/240)*240+120;
 if(action==='save')saveGame(true);
 if(['level','levelDelta','levelMax','allItems','hiddenItems','materials','give','drop','map','progress'].includes(action))saveGame(false);
 updateHUD();showAdmin();toast('관리자 변경 적용');
});


function resetAccountPreferences(){
 options={...DEFAULT_OPTIONS,shake:!detectedTouch,quality:detectedTouch?'low':'high'};
 try{const o=JSON.parse(localStorage.getItem(accountStorageKey(OPT_KEY)));if(o&&typeof o==='object')options={...options,...o};}catch(e){}
 keybinds={...KEY_DEFAULTS};try{const data=JSON.parse(localStorage.getItem(accountStorageKey(KEYS_KEY)));if(data&&Object.keys(KEY_DEFAULTS).every(k=>typeof data[k]==='string'))keybinds=data;}catch(e){}
 touchLayouts={portrait:{},landscape:{}};try{const data=JSON.parse(localStorage.getItem(accountStorageKey(LAYOUT_KEY)));for(const orientation of ['portrait','landscape'])for(const item of layoutItems){const p=data?.[orientation]?.[item.id];if(p&&Number.isFinite(p.x)&&Number.isFinite(p.y))touchLayouts[orientation][item.id]={x:clamp(p.x,0,1),y:clamp(p.y,0,1),size:Number.isFinite(p.size)?clamp(p.size,.8,1.6):1};}}catch(e){}
 saveAvailable=!!(currentAccount&&localStorage.getItem(accountStorageKey(SAVE_KEY)));
 applyControlMode();resize();updateKeyLabels();updateAccountUI();
}
function updateAccountUI(){const rec=accountRecord(),status=$('accountStatus'),login=$('accountLogin'),reg=$('accountRegister'),logout=$('accountLogout');if(!status)return;if(rec){status.innerHTML='<span class="account-name">'+esc(rec.displayName||rec.username)+'</span> 로그인 중 · 진행 자동 저장';login.classList.add('hidden');reg.classList.add('hidden');logout.classList.remove('hidden');}else{status.textContent='계정에 로그인하면 진행 상황을 저장할 수 있습니다.';login.classList.remove('hidden');reg.classList.remove('hidden');logout.classList.add('hidden');}if($('continueGame'))$('continueGame').disabled=!saveAvailable;}
function showAuth(kind='login',message=''){const register=kind==='register';openPanel('auth',header('ACCOUNT',register?'회원가입':'로그인')+(message?'<div class="tip">'+esc(message)+'</div>':'')+'<div class="auth-form"><label>아이디<input id="authUser" autocomplete="username" maxlength="20" placeholder="3~20자"></label><label>비밀번호<input id="authPass" type="password" autocomplete="'+(register?'new-password':'current-password')+'" maxlength="64" placeholder="6자 이상"></label>'+(register?'<label>비밀번호 확인<input id="authPass2" type="password" autocomplete="new-password" maxlength="64" placeholder="비밀번호 다시 입력"></label>':'')+'<div class="auth-note">이 계정은 이 HTML이 실행되는 현재 브라우저에 저장됩니다. 서버 계정이 아니므로 다른 기기와 자동 동기화되지는 않습니다.</div></div>'+footer('',register?'<button data-action="authSwitch" data-value="login">로그인으로</button><button class="primary" data-action="authRegister">회원가입</button>':'<button data-action="authSwitch" data-value="register">회원가입</button><button class="primary" data-action="authLogin">로그인</button>'));setTimeout(()=>$('authUser')?.focus({preventScroll:true}),0);}
async function registerAccount(){const display=String($('authUser')?.value||'').trim(),user=normalizeUser(display),pass=String($('authPass')?.value||''),pass2=String($('authPass2')?.value||'');if(!/^[A-Za-z0-9가-힣_]{3,20}$/.test(display)){showAuth('register','아이디는 3~20자의 한글·영문·숫자·밑줄만 사용할 수 있습니다.');return;}if(pass.length<6){showAuth('register','비밀번호는 6자 이상으로 입력하세요.');return;}if(pass!==pass2){showAuth('register','비밀번호 확인이 일치하지 않습니다.');return;}const accounts=readAccounts();if(accounts[user]){showAuth('register','이미 사용 중인 아이디입니다.');return;}const salt=randomSalt(),hash=await passwordDigest(pass,salt);accounts[user]={username:user,displayName:display,salt,hash,createdAt:new Date().toISOString(),lastLogin:new Date().toISOString()};writeAccounts(accounts);migrateLegacyToAccount(user);currentAccount=user;localStorage.setItem(SESSION_KEY,user);resetAccountPreferences();closeModal();toast('<b>'+esc(display)+'</b> 계정이 만들어졌습니다.');}
async function loginAccount(){const user=normalizeUser($('authUser')?.value),pass=String($('authPass')?.value||''),accounts=readAccounts(),rec=accounts[user];if(!rec){showAuth('login','아이디 또는 비밀번호를 확인하세요.');return;}const hash=await passwordDigest(pass,rec.salt);if(hash!==rec.hash){showAuth('login','아이디 또는 비밀번호를 확인하세요.');return;}rec.lastLogin=new Date().toISOString();accounts[user]=rec;writeAccounts(accounts);currentAccount=user;localStorage.setItem(SESSION_KEY,user);resetAccountPreferences();closeModal();toast('<b>'+esc(rec.displayName||rec.username)+'</b> 계정으로 로그인했습니다.');}
