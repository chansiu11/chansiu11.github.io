function npcQuestPanel(o,q,intro){const accepted=player.acceptedSideQuests.includes(q.id),done=player.claimedSideQuests.includes(q.id),n=sideQuestProgress(q),ready=accepted&&n>=q.target;return header('SIDE QUEST',o.name)+`<p class="dialog-text">${intro}</p><div class="card ${ready&&!done?'selected':''}"><div class="eyebrow">${done?'✓ 의뢰 완료':!accepted?'NEW REQUEST':ready?'REWARD READY':n+' / '+q.target}</div><h3>${q.name}</h3><p>${q.desc}</p><div class="price">보상 ${q.gold} G · 경험치 ${q.xp}${q.reward==='potion'?' · 회복약 2':q.reward==='ore'?' · 광석 5':''}</div>${accepted?`<div class="bar"><i style="background:var(--teal);width:${Math.min(100,n/q.target*100)}%"></i></div>`:''}</div>`+footer('',done?'<button data-action="quests" data-value="side">서브퀘스트 보기</button><button class="primary" data-action="close">대화 마치기</button>':!accepted?`<button data-action="acceptSide" data-value="${q.id}">의뢰 받기</button><button class="primary" data-action="close">나중에</button>`:ready?`<button data-action="claimSide" data-value="${q.id}">보상 받기</button><button class="primary" data-action="close">대화 마치기</button>`:'<button data-action="quests" data-value="side">진행 확인</button><button class="primary" data-action="close">대화 마치기</button>');}
