function snapshot(){const save=currentSave(),p=save?.player;if(!p)return null;const wi=clamp(Math.floor(p.weapon||0),0,3),w=weaponData[wi],up=Array.isArray(p.upgrades)?Number(p.upgrades[wi]||0):0,lvl=clamp(Number(p.level)||1,1,100),h=head[p.equippedHead]||head.wandererHood,c=chest[p.equippedChest]||chest.travelerCoat,sh=shields[p.equippedShield]||shields.woodenShield,resolve=Number(p.perks?.resolve||0);const maxHp=Math.round(120+(lvl-1)*18+resolve*12+h.hp+c.hp),maxShield=100+sh.shield,attack=Math.round(w.d+up*3+(lvl-1)*3.4),defense=h.def+c.def+sh.def,speed=Math.round(185*(1+h.move+c.move));return {name:displayName().slice(0,20),level:lvl,weapon:wi,weaponName:w.name,upgrade:up,maxHp,maxShield,attack,defense,speed};}
function loadoutHtml(s){return `<div><b>${s.name}</b><br>Lv.${s.level} · ${s.weaponName} +${s.upgrade}</div><div>HP ${s.maxHp} · 쉴드 ${s.maxShield}<br>공격 ${s.attack} · 방어 ${s.defense}</div>`}
function showLobby(msg=''){const s=snapshot();$('pvpLoadout').innerHTML=s?loadoutHtml(s):'<div>저장된 진행도가 없습니다.</div><div>로그인 후 여정을 저장한 다음 PVP에 참가하세요.</div>';$('pvpHost').disabled=!s;$('pvpJoin').disabled=!s;$('pvpLobby').classList.remove('hidden');$('pvpHud').classList.add('hidden');$('pvpCooldowns').classList.add('hidden');$('pvpScore').classList.add('hidden');$('pvpResult').classList.add('hidden');if(msg){$('pvpRoomView').textContent=msg;$('pvpRoomView').classList.remove('hidden')}else $('pvpRoomView').classList.add('hidden')}
function open(){document.querySelector('#title')?.classList.add('hidden');layer.classList.remove('hidden');showLobby();$('pvpStatus').textContent='방을 만들거나 참가하세요.';resize()}
function close(){stopNet();layer.classList.add('hidden');document.querySelector('#title')?.classList.remove('hidden')}
function resize(){const r=$('pvpStage').getBoundingClientRect(),ratio=W/H;if(r.width/r.height>ratio){canvas.style.width=(r.height*ratio)+'px';canvas.style.height=r.height+'px'}else{canvas.style.width=r.width+'px';canvas.style.height=(r.width/ratio)+'px'}}
function roomId(code){return 'echoes-pvp-'+code}
function cleanCode(v){return String(v||'').replace(/\D/g,'').slice(0,4)}
function randomCode(){return String(Math.floor(1000+Math.random()*9000))}
function stopNet(){running=false;try{conn?.close()}catch(e){}try{peer?.destroy()}catch(e){}peer=conn=null;remoteSnap=null;room='';keys.clear()}
function makePeer(id){if(typeof Peer!=='function')throw Error('PVP 연결 모듈을 불러오지 못했습니다. 인터넷 연결을 확인하세요.');return new Peer(id,{debug:0})}
function hostRoom(){stopNet();host=true;room=randomCode();$('pvpStatus').textContent='방 생성 중…';const tryOpen=()=>{peer=makePeer(roomId(room));peer.on('open',()=>{$('pvpRoomView').innerHTML='방 코드 <span class="pvp-code">'+room+'</span><br>상대가 이 코드를 입력하면 자동으로 연결됩니다.';$('pvpRoomView').classList.remove('hidden');$('pvpStatus').textContent='상대 참가 대기 중';});peer.on('connection',c=>{if(conn&&conn.open){c.close();return}bindConn(c)});peer.on('error',e=>{if(e.type==='unavailable-id'){try{peer.destroy()}catch(x){}room=randomCode();tryOpen()}else{$('pvpStatus').textContent='연결 오류 · '+e.type}})};try{tryOpen()}catch(e){showLobby(e.message)}}
function joinRoom(){const code=cleanCode($('pvpRoomInput').value);if(code.length!==4){showLobby('4자리 숫자 방 코드를 입력하세요.');return}stopNet();host=false;room=code;$('pvpStatus').textContent='방에 연결 중…';try{peer=makePeer();peer.on('open',()=>bindConn(peer.connect(roomId(code),{reliable:true,metadata:{game:'echoes'}})));peer.on('error',e=>{$('pvpStatus').textContent='방을 찾지 못했습니다 · '+e.type;showLobby('방 코드와 상대의 연결 상태를 확인하세요.')})}catch(e){showLobby(e.message)}}
function bindConn(c){conn=c;c.on('open',()=>{remoteSnap=null;c.send({t:'hello',v:1,s:snapshot()});$('pvpStatus').textContent='상대 진행도 확인 중…'});c.on('data',onData);c.on('close',()=>{if(running)finish(false,'상대가 연결을 종료했습니다.');$('pvpStatus').textContent='연결 종료'});c.on('error',()=>{$('pvpStatus').textContent='데이터 연결 오류'})}
function validSnap(s){return s&&Number.isFinite(s.level)&&Number.isFinite(s.maxHp)&&Number.isFinite(s.maxShield)&&Number.isFinite(s.attack)&&Number.isFinite(s.defense)&&s.level>=1&&s.level<=100&&s.maxHp>0&&s.maxHp<10000&&s.attack>0&&s.attack<1000}
function onData(m){if(!m||typeof m!=='object')return;if(m.t==='hello'&&validSnap(m.s)){remoteSnap=m.s;conn.send({t:'helloAck',s:snapshot()});startMatchIfReady()}else if(m.t==='helloAck'&&validSnap(m.s)){remoteSnap=m.s;startMatchIfReady()}else if(m.t==='state'&&enemy){enemy.x=clamp(+m.x||enemy.x,30,W-30);enemy.y=clamp(+m.y||enemy.y,30,H-30);enemy.a=+m.a||0;enemy.hp=clamp(+m.hp||0,0,enemy.maxHp);enemy.shield=clamp(+m.shield||0,0,enemy.maxShield);enemy.block=!!m.block;enemy.dash=Math.max(enemy.dash,+m.dash||0)}else if(m.t==='atk')receiveAttack(m)
else if(m.t==='proj'){projectiles.push({x:+m.x,y:+m.y,vx:+m.vx,vy:+m.vy,r:7,d:+m.d,owner:'enemy',life:1.5})}
else if(m.t==='ping')conn?.send({t:'pong',n:m.n})
else if(m.t==='pong')ping=Math.round(performance.now()-m.n)
else if(m.t==='round'){theirWins=clamp(+m.w||0,0,3);updateScore()}
else if(m.t==='rematch'){rematchTheirs=true;checkRematch()}
}
function startMatchIfReady(){if(!remoteSnap||!conn?.open)return;const s=snapshot();if(!s)return;me=createFighter(s,host?250:950,350,host?0:Math.PI);enemy=createFighter(remoteSnap,host?950:250,350,host?Math.PI:0);myWins=theirWins=0;running=true;roundLocked=false;rematchMine=rematchTheirs=false;$('pvpLobby').classList.add('hidden');$('pvpHud').classList.remove('hidden');$('pvpCooldowns').classList.remove('hidden');$('pvpScore').classList.remove('hidden');$('pvpResult').classList.add('hidden');$('pvpMeName').textContent=s.name;$('pvpEnemyName').textContent=remoteSnap.name;$('pvpMeInfo').textContent=`Lv.${s.level} · ${s.weaponName} +${s.upgrade}`;$('pvpEnemyInfo').textContent=`Lv.${remoteSnap.level} · ${remoteSnap.weaponName} +${remoteSnap.upgrade}`;$('pvpStatus').textContent='PVP 연결됨';updateScore();last=performance.now()}
function createFighter(s,x,y,a){return {...s,x,y,a,hp:s.maxHp,shield:s.maxShield,r:18,block:false,dash:0,inv:0,attackCd:0,cool:[0,0,0,0,0],stun:0,vx:0,vy:0}}
function resetRound(){if(!me||!enemy)return;me.x=host?250:950;me.y=350;me.a=host?0:Math.PI;me.hp=me.maxHp;me.shield=me.maxShield;me.stun=me.inv=me.dash=0;me.cool.fill(0);enemy.x=host?950:250;enemy.y=350;enemy.a=host?Math.PI:0;enemy.hp=enemy.maxHp;enemy.shield=enemy.maxShield;enemy.stun=enemy.inv=enemy.dash=0;projectiles=[];fx=[];roundLocked=false}
function updateScore(){$('pvpScore').textContent=`${myWins}  —  ${theirWins} · 3선승`;if(me&&enemy){$('pvpMeHp').style.width=(me.hp/me.maxHp*100)+'%';$('pvpMeShield').style.width=(me.shield/me.maxShield*100)+'%';$('pvpEnemyHp').style.width=(enemy.hp/enemy.maxHp*100)+'%';$('pvpEnemyShield').style.width=(enemy.shield/enemy.maxShield*100)+'%'}}
function damageTaken(raw){const mitigation=100/(100+Math.max(0,me.defense)*4);return Math.max(1,Math.round(raw*mitigation))}
function hurt(raw,stun=.08,kx=0,ky=0){if(!me||me.inv>0||roundLocked)return;if(me.block&&me.shield>0){const cost=Math.max(8,raw*.9);me.shield=Math.max(0,me.shield-cost);if(me.shield>0){burst(me.x,me.y,'#9edbe6',10);return}raw*=.55}const d=damageTaken(raw);me.hp=Math.max(0,me.hp-d);me.stun=Math.max(me.stun,stun);me.vx+=kx;me.vy+=ky;me.inv=.11;burst(me.x,me.y,'#f0aa9b',12);if(me.hp<=0)roundEnd(false)}
function receiveAttack(m){if(!me||!running||roundLocked)return;const dx=me.x-(+m.x||0),dy=me.y-(+m.y||0),dist=Math.hypot(dx,dy),range=clamp(+m.range||0,20,600);if(dist>range+me.r)return;const a=+m.a||0,arc=clamp(+m.arc||Math.PI*2,.2,Math.PI*2),diff=Math.abs(Math.atan2(Math.sin(Math.atan2(dy,dx)-a),Math.cos(Math.atan2(dy,dx)-a)));if(diff>arc/2&&arc<6)return;const force=clamp(+m.force||0,0,500),n=dist||1;hurt(clamp(+m.d||1,1,1000),clamp(+m.stun||.08,0,1.5),dx/n*force,dy/n*force)}
function sendAttack(range,d,arc=2,force=0,stun=.08){conn?.send({t:'atk',x:me.x,y:me.y,a:me.a,range,d,arc,force,stun});fx.push({x:me.x+Math.cos(me.a)*range*.55,y:me.y+Math.sin(me.a)*range*.55,r:range*.5,t:.22,c:'#f0d08a'})}
function basic(){if(!me||me.attackCd>0||me.stun>0)return;const w=weaponData[me.weapon]||weaponData[0];me.attackCd=w.cool;if(me.weapon===2){conn?.send({t:'proj',x:me.x,y:me.y,vx:Math.cos(me.a)*700,vy:Math.sin(me.a)*700,d:me.attack});projectiles.push({x:me.x,y:me.y,vx:Math.cos(me.a)*700,vy:Math.sin(me.a)*700,r:7,d:me.attack,owner:'me',life:1.5})}else sendAttack(w.range,me.attack,2.05,110,.12)}
function useSkill(i){if(!me||me.cool[i]>0||me.stun>0)return;const mult=[1.15,1.35,.42,1.65,2.2][i],cd=[4.5,7,8,10,14][i];me.cool[i]=cd;if(i===0){me.dash=.18;me.inv=.14;me.vx=Math.cos(me.a)*900;me.vy=Math.sin(me.a)*900;setTimeout(()=>{if(running)sendAttack(125,me.attack*mult,2.6,220,.35)},120)}else if(i===1){sendAttack(150,me.attack*mult,Math.PI*2,160,.35)}else if(i===2){for(let n=0;n<5;n++)setTimeout(()=>{if(running)sendAttack(135,me.attack*mult,1.45,55,.12)},n*90)}else if(i===3){me.dash=.34;me.inv=.18;me.vx=Math.cos(me.a)*720;me.vy=Math.sin(me.a)*720;setTimeout(()=>{if(running)sendAttack(180,me.attack*mult,2.4,280,.5)},300)}else{me.stun=.35;setTimeout(()=>{if(running)sendAttack(245,me.attack*mult,Math.PI*2,380,.65)},330)}burst(me.x,me.y,['#9ee8ff','#dcb0ff','#ffe29b','#ff9fc7','#fff2ae'][i],18+i*4)}
function roundEnd(win){if(roundLocked)return;roundLocked=true;if(win)myWins++;else theirWins++;conn?.send({t:'round',w:myWins});updateScore();if(myWins>=3||theirWins>=3){setTimeout(()=>finish(myWins>=3,myWins>=3?'3선승 승리':'3선승 패배'),550)}else setTimeout(resetRound,1200)}
function finish(win,text){running=false;$('pvpResultTitle').textContent=win?'PVP 승리':'PVP 종료';$('pvpResultText').textContent=text+' · 싱글 진행도는 변경되지 않았습니다.';$('pvpResult').classList.remove('hidden');rematchMine=rematchTheirs=false}
function rematch(){rematchMine=true;conn?.send({t:'rematch'});$('pvpResultText').textContent='상대의 재대결 선택을 기다리는 중…';checkRematch()}
function checkRematch(){if(rematchMine&&rematchTheirs){myWins=theirWins=0;running=true;$('pvpResult').classList.add('hidden');resetRound();updateScore()}}
function burst(x,y,c,n){for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,s=40+Math.random()*170;fx.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,r:2+Math.random()*4,t:.35+Math.random()*.3,c})}if(fx.length>220)fx.splice(0,fx.length-220)}
function input(dt){if(!me||roundLocked)return;const rect=canvas.getBoundingClientRect();if(mouse.active){const sx=W/rect.width,sy=H/rect.height,px=mouse.x*sx,py=mouse.y*sy;me.a=Math.atan2(py-me.y,px-me.x)}let x=(keys.has('KeyD')?1:0)-(keys.has('KeyA')?1:0),y=(keys.has('KeyS')?1:0)-(keys.has('KeyW')?1:0);const n=Math.hypot(x,y)||1;if(me.stun<=0&&!me.block){const sp=me.speed*(me.dash>0?1.8:1);me.x+=x/n*sp*dt;me.y+=y/n*sp*dt}me.x=clamp(me.x,25,W-25);me.y=clamp(me.y,25,H-25)}
function update(dt){if(!me||!enemy)return;for(const k of ['attackCd','stun','inv','dash'])me[k]=Math.max(0,me[k]-dt);for(let i=0;i<5;i++)me.cool[i]=Math.max(0,me.cool[i]-dt);if(me.dash>0){me.x+=me.vx*dt;me.y+=me.vy*dt}else{me.vx*=Math.pow(.02,dt);me.vy*=Math.pow(.02,dt);me.x+=me.vx*dt;me.y+=me.vy*dt}me.x=clamp(me.x,25,W-25);me.y=clamp(me.y,25,H-25);if(!me.block&&me.shield<me.maxShield)me.shield=Math.min(me.maxShield,me.shield+8*dt);input(dt);for(const p of projectiles){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;if(p.owner==='enemy'&&Math.hypot(p.x-me.x,p.y-me.y)<p.r+me.r){hurt(p.d,.12,p.vx*.12,p.vy*.12);p.life=0}}projectiles=projectiles.filter(p=>p.life>0&&p.x>-30&&p.x<W+30&&p.y>-30&&p.y<H+30);for(const f of fx){f.t-=dt;if(f.vx){f.x+=f.vx*dt;f.y+=f.vy*dt}}fx=fx.filter(f=>f.t>0);sendAt-=dt;pingAt-=dt;if(sendAt<=0&&conn?.open){sendAt=.05;conn.send({t:'state',x:me.x,y:me.y,a:me.a,hp:me.hp,shield:me.shield,block:me.block,dash:me.dash})}if(pingAt<=0&&conn?.open){pingAt=1;conn.send({t:'ping',n:performance.now()})}updateScore();$('pvpPing').textContent='PING '+(ping||'--')+'ms';$('pvpCooldowns').innerHTML=me.cool.map((v,i)=>`<span><b>${'QRTGV'[i]}</b>${v>0?v.toFixed(1):'READY'}</span>`).join('')}
function drawFighter(f,c,label){ctx.save();ctx.translate(f.x,f.y);ctx.rotate(f.a);ctx.fillStyle=c;ctx.beginPath();ctx.arc(0,0,18,0,Math.PI*2);ctx.fill();ctx.strokeStyle=f.block?'#a9e4ef':'#f2e8c8';ctx.lineWidth=f.block?5:2;ctx.beginPath();ctx.moveTo(8,-15);ctx.lineTo(25,0);ctx.lineTo(8,15);ctx.stroke();ctx.restore();ctx.fillStyle='#e8eee7';ctx.font='12px sans-serif';ctx.textAlign='center';ctx.fillText(label,f.x,f.y-29)}
function render(){ctx.fillStyle='#102126';ctx.fillRect(0,0,W,H);ctx.strokeStyle='#ffffff12';ctx.lineWidth=1;for(let x=0;x<W;x+=100){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke()}for(let y=0;y<H;y+=100){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}ctx.strokeStyle='#dfbf7b66';ctx.lineWidth=3;ctx.strokeRect(18,18,W-36,H-36);for(const p of projectiles){ctx.fillStyle=p.owner==='me'?'#f0d58b':'#a6d9ef';ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill()}for(const f of fx){ctx.globalAlpha=clamp(f.t/.5,0,1);ctx.strokeStyle=f.c;ctx.fillStyle=f.c;if(f.vx){ctx.beginPath();ctx.arc(f.x,f.y,f.r,0,Math.PI*2);ctx.fill()}else{ctx.lineWidth=4;ctx.beginPath();ctx.arc(f.x,f.y,f.r*(1.5-f.t),0,Math.PI*2);ctx.stroke()}}ctx.globalAlpha=1;if(me)drawFighter(me,'#dfbf7b',me.name);if(enemy)drawFighter(enemy,'#8ccbd5',enemy.name)}
function loop(t){requestAnimationFrame(loop);const dt=Math.min(.033,(t-last)/1000||0);last=t;if(!layer.classList.contains('hidden')){if(running)update(dt);render()}}
$('pvpBtn')?.addEventListener('click',open);$('pvpExit').addEventListener('click',close);$('pvpResultExit').addEventListener('click',close);$('pvpHost').addEventListener('click',hostRoom);$('pvpJoin').addEventListener('click',joinRoom);$('pvpRematch').addEventListener('click',rematch);$('pvpRoomInput').addEventListener('input',e=>e.target.value=cleanCode(e.target.value));window.addEventListener('resize',resize);canvas.addEventListener('mousemove',e=>{const r=canvas.getBoundingClientRect();mouse.x=e.clientX-r.left;mouse.y=e.clientY-r.top;mouse.active=true});canvas.addEventListener('mousedown',e=>{if(e.button===0&&running)basic()});window.addEventListener('keydown',e=>{if(layer.classList.contains('hidden'))return;if(['INPUT','TEXTAREA'].includes(document.activeElement?.tagName))return;keys.add(e.code);if(!running)return;if(e.code==='KeyZ'){e.preventDefault();basic()}if(e.code==='Space'){e.preventDefault();if(me.dash<=0&&me.stun<=0){me.dash=.16;me.inv=.13;me.vx=Math.cos(me.a)*720;me.vy=Math.sin(me.a)*720}}if(e.code==='KeyC')me.block=true;const i=['KeyQ','KeyR','KeyT','KeyG','KeyV'].indexOf(e.code);if(i>=0){e.preventDefault();useSkill(i)}});window.addEventListener('keyup',e=>{keys.delete(e.code);if(e.code==='KeyC'&&me)me.block=false});showLobby();requestAnimationFrame(loop);
})();
</script>
