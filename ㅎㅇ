function gearEffectText(g,slot){
 const parts=[];if(g.defense)parts.push('방어 '+g.defense);if(g.hp)parts.push('HP +'+g.hp);if(g.stam)parts.push('지구력 +'+g.stam);if(g.move)parts.push('이동 '+(g.move>0?'+':'')+Math.round(g.move*100)+'%');if(g.cdr)parts.push('스킬 쿨 -'+Math.round(g.cdr*100)+'%');if(slot==='shield')parts.push('최대 쉴드 '+(100+(g.shield||0)));if(g.regen)parts.push('쉴드 회복 +'+g.regen+'/초');return parts.join(' · ')||'기본 장비';
}
function equipmentCard(g,slot,owned,equipped){return `<div class="card ${equipped?'selected':''}"><div class="icon">${g.icon}</div><div class="eyebrow">${slot==='head'?'HEAD':slot==='chest'?'CHEST':'SHIELD'}</div><h3>${g.name}</h3><p>${g.desc}</p><div class="stat-row"><span>효과</span><b>${gearEffectText(g,slot)}</b></div><button data-action="equipArmor" data-value="${slot}:${g.id}" ${!owned||equipped?'disabled':''}>${equipped?'착용 중':owned?'장착':'미보유'}</button></div>`;}
function equipArmor(slot,id){
 const map={head:[HEAD_GEAR,'ownedHead','equippedHead'],chest:[CHEST_GEAR,'ownedChest','equippedChest'],shield:[SHIELD_GEAR,'ownedShields','equippedShield']},m=map[slot];if(!m||!m[0].some(g=>g.id===id)||!player[m[1]].includes(id))return;player[m[2]]=id;recalculateEquipment(false);player.shield=Math.min(player.shield,player.maxShield);sound('click');saveGame(false);showInventory('armor');updateHUD();
}
function grantEquipment(slot,id,announce=true){
 const map={head:[HEAD_GEAR,'ownedHead'],chest:[CHEST_GEAR,'ownedChest'],shield:[SHIELD_GEAR,'ownedShields']},m=map[slot];if(!m)return false;const g=m[0].find(v=>v.id===id);if(!g||player[m[1]].includes(id))return false;player[m[1]].push(id);if(announce){toast('<b>'+g.name+' 획득</b><br>가방 → 방어구에서 장착할 수 있습니다.');sound('reward');}return true;
}
