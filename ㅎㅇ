  body=`<p class="lede">메인 스토리는 순서대로 진행됩니다. 현재 장을 완료해야 다음 이야기가 열리며, 최종보스는 4번 구역 <b>종말의 별성</b>에서 기다립니다.</p><div class="grid two">${MAIN_QUESTS.map((mq,i)=>{const complete=i<player.storyStage||player.won&&i===MAIN_QUESTS.length-1,current=i===player.storyStage&&!player.won,n=complete?mq.target:current?mainQuestValue(i):0;return `<div class="card ${current?'selected':''}" style="${i>player.storyStage&&!complete?'opacity:.55':''}"><div class="eyebrow">${complete?'✓ '+mq.chapter:current?'◆ CURRENT · '+mq.chapter:'◇ '+mq.chapter}</div><h3>${mq.name}</h3><p>${i>player.storyStage&&!complete?'이전 메인퀘스트를 완료하면 내용이 공개됩니다.':mq.desc}</p><div class="bar"><i style="background:var(--gold);width:${complete?100:Math.min(100,n/mq.target*100)}%"></i></div><div class="price">${complete?'완료':current?n+' / '+mq.target:'잠김'} · 보상 ${mq.gold} G / 경험치 ${mq.xp}</div></div>`;}).join('')}</div>${q?`<div class="tip"><b>현재 메인 목표 · ${q.name}</b><br>${q.desc}</div>`:'<div class="tip"><b>메인 스토리 완료</b><br>별의 종언자를 쓰러뜨렸습니다. 서브퀘스트와 탐험은 계속할 수 있습니다.</div>'}`;
 }else{
